# syntax=docker/dockerfile:1.7
FROM node:22.22.0-bookworm-slim@sha256:e21fc383b50d5347dc7a9f1cae45b8f4e2f0d39f7ade28e4eef7d2934522b752 AS build
WORKDIR /src
COPY package.json package-lock.json ./
COPY apps apps
COPY packages packages
RUN --mount=type=cache,target=/root/.npm npm ci
RUN npm run build --workspace @stackpilot/web

FROM nginx:1.30.6-alpine3.24-slim@sha256:e2355aa95529a7999dad94ddcb45a8768abf6fb0b204c93b1a3ffce477d7b893
COPY deploy/nginx/container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/apps/web/dist /usr/share/nginx/html
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["wget","-qO-","http://127.0.0.1:8080/healthz"]
