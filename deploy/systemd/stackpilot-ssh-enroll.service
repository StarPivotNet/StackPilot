[Unit]
Description=StackPilot explicit SSH helper enrollment without changing SSH authentication
After=network-online.target
Wants=network-online.target
Conflicts=stackpilot-ssh-helper.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/stackpilot-ssh-helper/current
Environment=NODE_ENV=production
Environment=STACKPILOT_SSH_STATE_DIR=/var/lib/stackpilot-ssh-helper
EnvironmentFile=/etc/stackpilot-ssh-helper/helper.env
ExecStart=/usr/bin/node /opt/stackpilot-ssh-helper/current/apps/ssh-helper/dist/main.js enroll
TimeoutStartSec=30s
StateDirectory=stackpilot-ssh-helper
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
